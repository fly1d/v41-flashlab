{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://v41-flashlab.local/schemas/result-v1.schema.json",
  "title": "V41 FlashLab result record v1",
  "type": "object",
  "required": [
    "schema_version",
    "framework_version",
    "framework_revision",
    "run_id",
    "started_at",
    "finished_at",
    "suite",
    "suite_version",
    "suite_sha256",
    "case_id",
    "attempt",
    "model",
    "endpoint_host",
    "endpoint",
    "deployment",
    "stream",
    "generation_parameters",
    "metadata",
    "response",
    "metrics",
    "score",
    "error"
  ],
  "properties": {
    "schema_version": {"const": "v41-flashlab.result.v1"},
    "framework_version": {"type": "string", "minLength": 1},
    "framework_revision": {"type": ["string", "null"]},
    "run_id": {"type": "string", "minLength": 1},
    "started_at": {"type": "string", "minLength": 1},
    "finished_at": {"type": "string", "minLength": 1},
    "suite": {"type": "string", "minLength": 1},
    "suite_version": {"type": ["string", "null"]},
    "suite_sha256": {"type": ["string", "null"]},
    "case_id": {"type": "string", "minLength": 1},
    "attempt": {"type": "integer", "minimum": 1},
    "model": {"type": "string", "minLength": 1},
    "endpoint_host": {"type": ["string", "null"]},
    "endpoint": {"type": ["string", "null"]},
    "deployment": {"type": "object"},
    "stream": {"type": "boolean"},
    "generation_parameters": {"type": "object"},
    "metadata": {"type": "object"},
    "response": {"type": ["object", "null"]},
    "metrics": {
      "type": "object",
      "required": [
        "latency_ms",
        "ttft_ms",
        "answer_ttft_ms",
        "input_tokens",
        "output_tokens",
        "total_tokens",
        "usage_details"
      ],
      "properties": {
        "latency_ms": {"type": ["number", "null"], "minimum": 0},
        "ttft_ms": {"type": ["number", "null"], "minimum": 0},
        "answer_ttft_ms": {"type": ["number", "null"], "minimum": 0},
        "input_tokens": {"type": ["integer", "null"], "minimum": 0},
        "output_tokens": {"type": ["integer", "null"], "minimum": 0},
        "total_tokens": {"type": ["integer", "null"], "minimum": 0},
        "usage_details": {"type": "object"}
      }
    },
    "score": {
      "type": ["object", "null"],
      "properties": {
        "type": {"type": "string"},
        "passed": {"type": ["boolean", "null"]},
        "score": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "details": {"type": "object"}
      }
    },
    "error": {
      "type": ["object", "null"],
      "properties": {
        "type": {"type": "string", "minLength": 1},
        "message": {"type": "string"},
        "status_code": {"type": ["integer", "null"]}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"error": {"type": "null"}}},
      "then": {"properties": {"response": {"type": "object"}}},
      "else": {
        "properties": {
          "response": {"type": "null"},
          "score": {"type": "null"}
        }
      }
    }
  ]
}

# Official DeepSeek OpenAI-compatible endpoint. Do not commit a populated file.
FLASHLAB_BASE_URL=https://api.deepseek.com/v1
FLASHLAB_API_KEY=
FLASHLAB_MODEL=deepseek-flash

# Instead of FLASHLAB_API_KEY, you may use DEEPSEEK_API_KEY when the base URL
